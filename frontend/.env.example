# ─── ProjectHive Frontend — Local Environment Configuration ────────────────────
# Copy this file to .env.local for local Next.js development

# ─── 1. Backend API & WebSocket Connections ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ─── 2. Supabase Client Bindings (Anon Scope) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── 3. LiveKit SFU Client Endpoint ────────────────────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
