# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║        ProjectHive Frontend — Vercel Production Environment Matrix          ║
# ║  Target Hosting: Vercel / Cloudflare Pages / AWS Amplify                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── 1. BACKEND API & SOCKET CONNECTIONS ──────────────────────────────────────
# The root production URL of your Express backend server
NEXT_PUBLIC_API_URL=https://projecthive-backend.onrender.com/api

# The Socket.IO real-time server URL (typically root origin of your backend)
NEXT_PUBLIC_SOCKET_URL=https://projecthive-backend.onrender.com

# ─── 2. SUPABASE DIRECT CLIENT BINDINGS (ANON SCOPED) ─────────────────────────
# Direct browser connections to Supabase (e.g. storage downloads, realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# ─── 3. LIVEKIT SFU WEBRTC SFU ENDPOINT (CLIENT) ──────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=wss://projecthive-livekit.yourdomain.com
