# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║        ProjectHive Backend — Production Environment Configuration Template   ║
# ║  Target Hosting: Render / Railway / Fly.io / AWS ECS / Self-Hosted VPS       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

NODE_ENV=production
PORT=5000

# ─── 1. SUPABASE CREDENTIALS (MANDATORY) ──────────────────────────────────────
# Note: SUPABASE_SERVICE_ROLE_KEY is required by the backend to bypass RLS policies
# for administrative queries, system flags, and server-side operations.
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key

# ─── 2. JWT SECURITY CREDENTIALS (MANDATORY) ──────────────────────────────────
# Provide a cryptographically secure 64-character string or RS256 private/public keypair
JWT_SECRET=generate_with_openssl_rand_hex_64_minimum_length_key
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── 3. SUPERADMIN AUTONOMOUS PROMOTION ───────────────────────────────────────
# When this email logs in, backend guarantees role = 'admin' & is_verified = true
ADMIN_EMAIL=admin@projecthive.edu

# ─── 4. CORS & FRONTEND BINDINGS (CRITICAL FOR SOCKET.IO) ─────────────────────
# Replace with your actual production Vercel / custom domains
CLIENT_URL=https://projecthive.vercel.app
FRONTEND_URL=https://projecthive.vercel.app
FRONTEND_URL_PROD=https://projecthive.vercel.app

# ─── 5. HIGH-PERFORMANCE REDIS ADAPTER (OPTIONAL BUT RECOMMENDED) ─────────────
# Required for horizontal scaling of Socket.IO instances across multiple nodes
# Free tier available at Upstash: https://console.upstash.com
REDIS_URL=rediss://default:your-upstash-redis-token@your-redis.upstash.io:6379

# ─── 6. AI ENGINE INTEGRATION (HYBRID CASCADE) ────────────────────────────────
# 1. Groq (Primary High-Speed Llama 3.3 70B & DeepSeek R1) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_production_api_key

# 2. Google Gemini (Multimodal Vision & Project Plan Generator) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key

# 3. OpenRouter (Zero-Downtime Fallback Cascade) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# ─── 7. TRANSACTIONAL EMAIL — BREVO API ───────────────────────────────────────
# API key from https://app.brevo.com (Profile -> SMTP & API -> API Keys)
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=notifications@projecthive.edu

# ─── 8. WEBRTC AUDIO & VIDEO CALLING ENGINE (LIVEKIT SFU) ─────────────────────
# Cloud or self-hosted LiveKit instance for peer & squad video conferencing
LIVEKIT_URL=wss://projecthive-livekit.yourdomain.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── 9. RATE LIMITING & SECURITY THRESHOLDS ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MS=900000

# ─── 10. KEEP-ALIVE SYSTEM ────────────────────────────────────────────────────
# Auto pinging to keep free/hobby-tier instances warm
APP_URL_PROD=https://projecthive-backend.onrender.com
